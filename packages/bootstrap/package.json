{
  "name": "@ocso/bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Infrastructure composition shared by api and worker: adapter selection by configuration.",
  "exports": {
    ".": {
      "@ocso/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ocso/blob": "workspace:*",
    "@ocso/config": "workspace:*",
    "@ocso/db": "workspace:*",
    "@ocso/queue": "workspace:*",
    "@ocso/secrets": "workspace:*",
    "@aws-sdk/client-secrets-manager": "catalog:",
    "@aws-sdk/client-sqs": "catalog:",
    "drizzle-orm": "catalog:"
  }
}
