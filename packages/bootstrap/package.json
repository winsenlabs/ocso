{
  "name": "@ocso/bootstrap",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Composition root shared by api and worker: the OCSO plugin list, registries built from it, and driver selection by configuration.",
  "exports": {
    ".": {
      "@ocso/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ocso/blob": "workspace:*",
    "@ocso/config": "workspace:*",
    "@ocso/db": "workspace:*",
    "@ocso/queue": "workspace:*",
    "@ocso/secrets": "workspace:*",
    "@ocso/deployment": "workspace:*",
    "@ocso/email": "workspace:*",
    "@aws-sdk/client-secrets-manager": "catalog:",
    "@aws-sdk/client-sqs": "catalog:",
    "drizzle-orm": "catalog:",
    "@ocso/mcp": "workspace:*",
    "@ocso/model-providers": "workspace:*",
    "@ocso/channels": "workspace:*",
    "@ocso/agent-runtime": "workspace:*",
    "@ocso/tools": "workspace:*",
    "@ocso/application": "workspace:*",
    "@ocso/domain": "workspace:*",
    "@ocso/alerts": "workspace:*",
    "pg": "catalog:",
    "@ocso/audit-store": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "catalog:"
  }
}
