{
  "name": "@ocso/audit-store",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "The audit store: a separate, append-only system of record for audit events (hash chain, Ed25519 checkpoints), with postgres and clickhouse drivers.",
  "exports": {
    ".": {
      "@ocso/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ocso/config": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:"
  }
}
