# OCSO website (apps/website). Local: copy to .env.local. VPS: set in the Compose .env; secrets arrive as FILES
# on the ocso secrets volume (the `website` subpath, mounted at /run/secrets/ocso-website) — see
# infra/compose/website.yaml and docs/operations/compose.md, "Public website".
# Every secret can be given directly (NAME=value) or as a file (NAME_FILE=/path); a direct value wins.

# Public origin: canonical URLs, sitemap, llms.txt and the image in emails. Baked in at build time.
OCSO_SITE_URL=https://ocso.winsenlabs.dev

# Cloudflare account that owns the D1 database and the email sending domain (not secret).
CLOUDFLARE_ACCOUNT_ID=
# Secret. An account API token with: Account > D1 > Edit, and Account > Email Sending > Edit (for EMAIL_PROVIDER=cloudflare).
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_API_TOKEN_FILE=/run/secrets/ocso-website/cloudflare_api_token

# D1 database `ocso-site` (table site_demo_requests, migrations/0001_site_demo_requests.sql). Not secret.
SITE_D1_DATABASE_ID=92f036f3-a106-40ab-9955-d9ea2ec9c2d4

# Email. cloudflare (default): Cloudflare Email Service, from winsenlabs.dev (onboarded to Email Sending).
# resend: Resend, from the Resend-verified winsenlabs.dev domain; needs RESEND_API_KEY(_FILE). log: print only.
EMAIL_PROVIDER=cloudflare
EMAIL_FROM=OCSO <ocso@winsenlabs.dev>
EMAIL_REPLY_TO=hello@winsenlabs.com
# RESEND_API_KEY=
# RESEND_API_KEY_FILE=/run/secrets/ocso-website/resend_api_key

# The Slack channel's email address (Channel details > Integrations > Send emails to this channel).
# Every demo request is sent here. Treat it as a secret: anyone with it can post to the channel.
SLACK_NOTIFY_EMAIL=
# SLACK_NOTIFY_EMAIL_FILE=/run/secrets/ocso-website/slack_notify_email

# Testing only, never in production: send every email (the acknowledgement too) to one address, with a prefix.
# EMAIL_REDIRECT_ALL_TO=
# EMAIL_SUBJECT_PREFIX=[TEST] 
