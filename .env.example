# OCSO — Docker Compose settings (copy to .env; every line is optional).
#
#   cp .env.example .env && docker compose up -d
#
# SECRETS DO NOT BELONG HERE. The `keygen` service generates the database
# password, SecretStore master key, blob signing key, internal signing key
# and first-run setup token into the `secrets` volume on first start. Values
# set below override the generated ones (useful for managed PostgreSQL); keep
# .env out of git (it is in .gitignore) and readable only by the operator.
# See docs/operations/compose.md.

# ── Public origin ──────────────────────────────────────────────────────────────
# URL customers, channel providers (webhooks) and OAuth callbacks reach. Put a
# TLS-terminating reverse proxy in front for anything beyond localhost.
OCSO_PUBLIC_URL=http://localhost:3000
# Host interface/port for the web app (the only published service).
OCSO_HTTP_BIND=0.0.0.0
OCSO_HTTP_PORT=3000
# Session cookie `Secure` flag. Keep true (browsers accept it on localhost);
# false ONLY for a plain-http trial on another host.
SESSION_COOKIE_SECURE=true
# Number of reverse proxies in front of the web app that append X-Forwarded-For
# (e.g. 1 behind Caddy/nginx/an ALB). Used for per-address sign-in throttling
# and audit; 0 ignores the header because clients could forge it.
OCSO_TRUSTED_PROXY_HOPS=0

# ── Images ─────────────────────────────────────────────────────────────────────
# `docker compose build` tags ${OCSO_IMAGE_PREFIX}/<service>:${OCSO_VERSION}.
# Point these at your registry to deploy prebuilt images (docker compose pull).
OCSO_IMAGE_PREFIX=ocso
OCSO_VERSION=local
# OCSO_POSTGRES_IMAGE=postgres:18.6

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the bundled postgres service. For managed
# PostgreSQL (e.g. RDS) set the full URL and DATABASE_SSL=true; the bundled
# postgres container can then be scaled to 0.
# DATABASE_URL=postgres://ocso:<password>@db.internal:5432/ocso
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# ── Blob storage (ADR-011) ────────────────────────────────────────────────────
# local = the `blobs` volume (default). s3 = the SeaweedFS `s3` profile:
#   BLOB_DRIVER=s3 docker compose --profile s3 up -d
BLOB_DRIVER=local
# S3_BUCKET=ocso-media
# S3_ENDPOINT=http://seaweedfs:8333
# AWS_REGION=us-east-1

# ── First-run setup ───────────────────────────────────────────────────────────
# Generated automatically; shown by `docker compose logs api | grep "setup token"`.
# OCSO_SETUP_TOKEN=

# ── Demo (profile `demo`) ─────────────────────────────────────────────────────
# OCSO_DEMO_SEED=true seeds the Meridian Bank demo on a FRESH database and
# enables the development-only scripted model provider (ADR-015):
#   OCSO_DEMO_SEED=true docker compose --profile demo up -d
OCSO_DEMO_SEED=false
# Password for every demo account (min 12 chars). Default: meridian-demo-2026
# OCSO_DEMO_PASSWORD=
# Dev provider without the demo seed (never in real production):
# OCSO_ENABLE_DEV_PROVIDERS=true
# OCSO_ALLOW_DEV_PROVIDERS_IN_PRODUCTION=true

# ── Observability (profile `observability`) ───────────────────────────────────
#   OTEL_ENABLED=true docker compose --profile observability up -d
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OCSO_JAEGER_UI_PORT=16686
