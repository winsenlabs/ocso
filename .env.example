# OCSO — Docker Compose settings (copy to .env; every line is optional).
#
#   cp .env.example .env && docker compose up -d
#
# SECRETS DO NOT BELONG HERE. The `keygen` service generates the database
# password, SecretStore master key, blob signing key, internal signing key
# and first-run setup token into the `secrets` volume on first start. Values
# set below override the generated ones (useful for managed PostgreSQL); keep
# .env out of git (it is in .gitignore) and readable only by the operator.
# See docs/operations/compose.md.

# ── Public origin ──────────────────────────────────────────────────────────────
# URL customers, channel providers (webhooks) and OAuth callbacks reach. Put a
# TLS-terminating reverse proxy in front for anything beyond localhost — e.g.
# the bundled Caddy overlay (docs/operations/compose.md §2, "HTTPS"):
#   docker compose -f compose.yaml -f infra/compose/tls.yaml up -d
# with OCSO_DOMAIN set, OCSO_PUBLIC_URL=https://<OCSO_DOMAIN>,
# OCSO_HTTP_BIND=127.0.0.1 and OCSO_TRUSTED_PROXY_HOPS=1.
OCSO_PUBLIC_URL=http://localhost:3000
# Domain Caddy obtains a Let's Encrypt certificate for (TLS overlay only; its
# DNS A/AAAA record must point at this host, ports 80 and 443 open).
# OCSO_DOMAIN=ocso.example.com
# Public website (infra/compose/website.yaml overlay only): its domain, and the
# origin its canonical URLs and sitemap are built for.
# OCSO_WEBSITE_DOMAIN=www.example.com
# OCSO_SITE_URL=https://www.example.com
# Host interface/port for the web app (the only published service). Behind the
# TLS overlay use 127.0.0.1: Docker's published ports bypass host firewalls.
OCSO_HTTP_BIND=0.0.0.0
OCSO_HTTP_PORT=3000
# Session cookie `Secure` flag (set by the API's Better Auth, ADR-025). Keep
# true (browsers accept it on localhost); false ONLY for a plain-http trial on
# another host.
SESSION_COOKIE_SECURE=true
# Number of reverse proxies in front of the web app that append X-Forwarded-For
# (e.g. 1 behind Caddy/nginx/an ALB). Used for per-address sign-in throttling
# and audit; 0 ignores the header because clients could forge it.
OCSO_TRUSTED_PROXY_HOPS=0

# ── Images ─────────────────────────────────────────────────────────────────────
# `docker compose build` tags ${OCSO_IMAGE_PREFIX}/<service>:${OCSO_VERSION}.
# Point these at your registry to deploy prebuilt images (docker compose pull).
OCSO_IMAGE_PREFIX=ocso
OCSO_VERSION=local
# OCSO_POSTGRES_IMAGE=postgres:18.6

# ── Workers ────────────────────────────────────────────────────────────────────
# Agent worker replicas (docs/operations/worker-scaling.md). Workers lease conversations in
# PostgreSQL, so any replica takes over a lost worker's conversations. Keep
# DATABASE_POOL_SIZE × (api + workers) below PostgreSQL max_connections (100).
OCSO_WORKER_REPLICAS=2

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the bundled postgres service. For managed
# PostgreSQL (e.g. RDS) set the full URL and DATABASE_SSL=true; the bundled
# postgres container can then be scaled to 0.
# DATABASE_URL=postgres://ocso:<password>@db.internal:5432/ocso
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# ── Audit store (ADR-032, docs/operations/compose.md §10) ──────────────────────
# Audit events are kept in their own database, the system of record: the bundled
# `audit-db` service by default. The api and worker write as an INSERT/SELECT-only
# role; keygen generates its password, the owner password and the Ed25519 signing
# key (secrets volume). For a managed PostgreSQL, set both URLs (the owner is used
# only by the migrate step) and AUDIT_DATABASE_SSL=true; if your DBA created the
# writer role, also AUDIT_PROVISION_ROLE=false.
AUDIT_DRIVER=postgres
# AUDIT_DATABASE_URL=postgres://ocso_audit_writer:<password>@audit.internal:5432/ocso_audit
# AUDIT_DATABASE_OWNER_URL=postgres://ocso_audit:<password>@audit.internal:5432/ocso_audit
# The api's SELECT-only reader (audit-migrate creates it; the worker keeps the writer):
# AUDIT_READER_URL=postgres://ocso_audit_reader:<password>@audit.internal:5432/ocso_audit
# The store's own minimum retention: no purge ever removes anything younger (≥ 365).
# AUDIT_MIN_RETENTION_DAYS=2555
# Production refuses a writer that is the database owner unless this is true.
# AUDIT_ALLOW_OWNER_WRITER=false
# Bound on each audit store call (ms); a store that stops answering fails fast.
# AUDIT_STORE_TIMEOUT_MS=15000
# After rotating the signing key: retired public keys (PEM bundle) older checkpoints verify against.
# AUDIT_TRUSTED_PUBLIC_KEYS_FILE=/run/secrets/ocso/audit_trusted_public_keys.pem
AUDIT_DATABASE_SSL=false
AUDIT_DATABASE_POOL_SIZE=5
# AUDIT_PROVISION_ROLE=true
# ClickHouse instead (AUDIT_DRIVER=clickhouse): the HTTP interface, a writer user
# (SELECT/INSERT), an admin user for the migrate step, and optionally a purge user
# (worker only) that drops months past the audit retention.
# CLICKHOUSE_URL=http://clickhouse.internal:8123
# CLICKHOUSE_DATABASE=ocso_audit
# CLICKHOUSE_USER=ocso_audit_writer
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_ADMIN_USER=default
# CLICKHOUSE_ADMIN_PASSWORD=
# CLICKHOUSE_PURGE_USER=ocso_audit_purge
# CLICKHOUSE_PURGE_PASSWORD=
# CLICKHOUSE_READER_USER=ocso_audit_reader   (the api; password AUDIT_READER_PASSWORD)

# ── Blob storage (ADR-011) ────────────────────────────────────────────────────
# local = the `blobs` volume (default). s3 = the SeaweedFS `s3` profile:
#   BLOB_DRIVER=s3 docker compose --profile s3 up -d
BLOB_DRIVER=local
# S3_BUCKET=ocso-media
# S3_ENDPOINT=http://seaweedfs:8333
# AWS_REGION=us-east-1

# ── First-run setup and authentication (ADR-025) ──────────────────────────────
# Generated automatically; shown by `docker compose logs api | grep "setup token"`.
# OCSO_SETUP_TOKEN=
# BETTER_AUTH_SECRET is generated by keygen (secrets volume); set it only to
# share one value across hosts. Changing it signs everyone out and makes
# enrolled authenticator apps unusable (users re-enrol).
# Idle and absolute session lifetime.
# SESSION_IDLE_MINUTES=120
# SESSION_ABSOLUTE_HOURS=24
# An OIDC identity provider on a private network must be listed here.
# OCSO_AUTH_TRUSTED_ORIGINS=https://idp.corp.internal
# Break-glass recovery for a locked-out Tech Admin (/recover): set a random
# value of 32+ characters, restart the api, use it once, then remove it.
# OCSO_RECOVERY_TOKEN=

# ── Email (docs/operations/compose.md §9) ─────────────────────────────────────
# Invites, password resets, sign-in codes and alert emails. Configured here,
# not in the web app (Settings → Email only shows the status and sends a test).
# Until EMAIL_DRIVER is set, email only goes to the api/worker log (a trial
# starts without it; Settings → Email warns). Configure Resend before inviting
# users. EMAIL_ALLOW_LOG_IN_PRODUCTION=false makes missing email a start-up error.
# EMAIL_DRIVER=resend
# Sender on a domain verified in Resend (or allowed by your SMTP relay):
# EMAIL_FROM=Acme Support <support@mail.acme.com>
# EMAIL_REPLY_TO=support@acme.com
# EMAIL_ALLOW_LOG_IN_PRODUCTION=false
#
# Resend: put the API key in a file on the secrets volume (see compose.md) and
# point at it. RESEND_API_KEY=re_… also works but leaves the key in .env.
# RESEND_API_KEY_FILE=/run/secrets/ocso/resend_api_key
#
# SMTP (any relay): host/port, implicit TLS on 465, STARTTLS required elsewhere
# unless SMTP_REQUIRE_TLS=false (local relays only). Password as a file too.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD_FILE=/run/secrets/ocso/smtp_password

# ── Demo (profile `demo`) ─────────────────────────────────────────────────────
# OCSO_DEMO_SEED=true seeds the Meridian Bank demo on a FRESH database and
# enables the development-only scripted model provider (ADR-015):
#   OCSO_DEMO_SEED=true docker compose --profile demo up -d
OCSO_DEMO_SEED=false
# Password for every demo account (min 12 chars). Default: meridian-demo-2026
# OCSO_DEMO_PASSWORD=
# Dev provider without the demo seed (never in real production):
# OCSO_ENABLE_DEV_PROVIDERS=true
# OCSO_ALLOW_DEV_PROVIDERS_IN_PRODUCTION=true

# ── Observability (profile `observability`) ───────────────────────────────────
#   OTEL_ENABLED=true docker compose --profile observability up -d
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OCSO_JAEGER_UI_PORT=16686
