# Static file server inside the `website` image (Dockerfile target `website`).
# Plain HTTP on :8080; TLS and the security headers come from the Caddy in front
# (infra/compose/website.yaml).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	respond /healthz 200

	# Hashed build assets never change; everything else revalidates.
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_next/static/*
	header @pages Cache-Control "public, max-age=300"

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}

	log {
		output stdout
		format json
	}
}
